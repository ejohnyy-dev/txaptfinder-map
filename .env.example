# Houston Apartment Locator - Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# RentCast API for apartment listings (REQUIRED for apartment data)
RENTCAST_API_KEY=your_rentcast_api_key_here

# OAuth Configuration (REQUIRED for user authentication)
OAUTH_SERVER_URL=https://your-oauth-server.com
OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret

# HubSpot CRM Integration (REQUIRED for lead capture)
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_token_here

# Google Sheets Integration for lead backup (OPTIONAL)
GOOGLE_SHEETS_ENDPOINT=https://your-google-sheets-endpoint

# Frontend Analytics (OPTIONAL)
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your_site_id
VITE_FRONTEND_FORGE_API_KEY=your_forge_key
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (if using local database)
DATABASE_URL=mysql://user:password@localhost:3306/apartments
